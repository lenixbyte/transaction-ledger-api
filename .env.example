# Postgres connection string. For Supabase: Project Settings -> Database -> Connection string
# (use the "Session pooler" URI if your network has no IPv6).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# TLS is used automatically for non-local hosts (Supabase needs it). Set to false to disable.
# DATABASE_SSL=false
PORT=3000
# Browser origins allowed to call the API (comma-separated), e.g. your frontend URL.
CORS_ORIGINS=*
TOKEN_TTL_HOURS=168
# Only for `npm test`: a Postgres the tests may create/drop schemas in.
# TEST_DATABASE_URL=postgres://postgres:test@127.0.0.1:55450/ledger_test
